
FROM node:22-alpine AS assets

WORKDIR /build

COPY package.json package-lock.json ./
COPY scripts/vendor.mjs scripts/vendor.mjs

RUN npm ci --omit=dev

FROM nginx:alpine

COPY hrml /usr/share/nginx/html/index.html
COPY static/ /usr/share/nginx/html/static/

COPY --from=assets /build/static/vendor/ /usr/share/nginx/html/static/vendor/

ENV BACKEND_URL=http://backend:8000 BACKEND_HOST_HEADER=\$http_host NGINX_ENVSUBST_FILTER=^BACKEND_
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
