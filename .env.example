# Compose reads .env automatically. For direct Python use, export these variables.
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=/data/accounts.sqlite3
# Append your Ubuntu LAN IP or public hostname. No scheme or port.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Required by Compose. Paste the generated value here before starting containers.
APP_SECRET=
# Set true only when serving through HTTPS.
COOKIE_SECURE=false
# Bind 127.0.0.1 behind a reverse proxy; 0.0.0.0 for trusted LAN access.
BIND_ADDRESS=0.0.0.0
# Optional exact proxy IP seen by the backend. Leave empty for HTTP LAN access.
TRUSTED_PROXY=
